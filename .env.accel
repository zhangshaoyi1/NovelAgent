# ============================================================
# NovelAgent 加速续写配置（.env.accel）
# ------------------------------------------------------------
# 本文件由「加速方案」生成，配合 accelerated_write.py 使用：
#   NOVEL_AGENT_DOTENV=.env.accel python accelerated_write.py --execute
#
# 设计原则：只调「调度/容错/成本」类参数，绝不改主创作模型，不影响正文质量。
# 启用方式：复制为 .env 或在自动化 prompt 中加 `set NOVEL_AGENT_DOTENV=.env.accel`
# 当前未启用（自动化任务仍 PAUSED，不续写）。
# ============================================================

# --- ② provider 自动切换 + 限流退避 ---
# 主 provider 沿用现有 .env 的 LLM_PROVIDER / LLM_MODEL_ID。
# 仅补充回退链：主 provider 网络不可达时自动切到备用（LLMClient 原生支持）。
# 注意：请按你的实际可用端点填写下方占位（不要留空，空则无回退）。
LLM_FALLBACK_PROVIDER=opencode.ai
LLM_FALLBACK_MODEL=

# 指数退避重试（规避限流导致的整批停滞）：
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=2

# --- 分层模型路由（PRD 决策 3）---
# 创作用主模型（强）：保持与现有 .env 一致，不在此覆盖 → 正文质量不变。
# 校验/摘要用轻量模型（低成本）：设一个便宜快的模型，降低质检开销。
# 若留空则回退主模型（不影响质量，只是没省成本）。
LLM_MODEL_UTILITY=

# 关闭思考（提速、省 token，适合批量长篇流水线）：
LLM_ENABLE_THINKING=false

# --- 超时（批量写章适当放宽，避免长章超时失败）---
LLM_TIMEOUT=180

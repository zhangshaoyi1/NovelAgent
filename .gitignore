# Python 缓存
__pycache__/
*.pyc
*.pyo

# 密钥：绝不提交 .env（含 LLM API Key 等敏感信息）
.env
.env.accel

# 测试 / lint 缓存
.pytest_cache/
.ruff_cache/
.coverage

# 构建产物
*.egg-info/
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# 运行时状态（G9 progress.json 等，运行产物不入库）
/.state/
.progress.json

# G11：skill 导出产物（不入库）
dist/skills/

# 小说项目运行时数据（不入库）
/projects/
/.workbuddy/
# 测试密钥（.env_ai 含测试用 API Key，同样不入库）
.env_ai
.idea/

# 备份输出（非项目代码）
outputs/

# 开发笔记/思考记录（非项目代码）
.agents/


{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Novel Agent State",
  "description": "Agent 状态机持久化文件 schema（.state/state.json）",
  "type": "object",
  "required": ["state", "progress", "mode"],
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "INIT",
        "CONFIGURING",
        "DISCUSSING",
        "ARCHITECTING",
        "ARCH_CONFIRMED",
        "ARCH_REVISION",
        "OUTLINING",
        "CHARACTER_DESIGN",
        "WRITING",
        "PAUSED",
        "COMPLETED"
      ],
      "description": "当前状态机位置"
    },
    "progress": {
      "type": "object",
      "description": "进度指针",
      "properties": {
        "current_subline": {"type": "string"},
        "current_episode": {"type": "string"},
        "current_chapter_index": {"type": "integer", "minimum": 0},
        "total_chapters": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "mode": {
      "type": "string",
      "enum": ["heavy", "light", "auto"],
      "description": "介入频率模式"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "上次活动时间（用于续作恢复判断）"
    },
    "architecture_confirmed": {
      "type": "boolean",
      "description": "故事架构是否已确认（门禁字段）"
    }
  },
  "additionalProperties": false
}
